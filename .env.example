# Supabaseプロジェクトの設定 (Project Settings > API から取得)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 広告スロットを有効にするか (v1では false のまま)
VITE_ADS_ENABLED=false

# 同意画面を出すか(規約の正式公開後に true。docs/legal-checklist.md)
VITE_CONSENT_REQUIRED=false

# ---- 以下はサーバー(Vercel Function)だけで使う。VITE_ を付けない(アプリの配信物に含めない) ----
# お問い合わせの通知(docs/operations.md)。Vercel の Production 環境にだけ設定する
# SUPABASE_SERVICE_ROLE_KEY=
# CONTACT_NOTIFY_WEBHOOK_URL=        # Slack / Discord の Incoming Webhook。または下の Resend
# RESEND_API_KEY=
# CONTACT_NOTIFY_EMAIL_TO=
# CONTACT_NOTIFY_EMAIL_FROM=
